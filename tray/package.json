{
  "name": "claude-usage-tray",
  "version": "0.1.0",
  "description": "Claude Code 사용량을 Windows/macOS 트레이에 표시하는 Electron 앱",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.js",
    "start": "electron .",
    "dev": "node esbuild.js && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.wemeet.claude-usage-tray",
    "productName": "Claude Usage",
    "files": ["dist/**/*", "package.json"],
    "win": {
      "target": "portable"
    }
  }
}
